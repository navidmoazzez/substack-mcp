{
  "name": "@thenavidm/substack-mcp",
  "version": "2.0.0",
  "description": "MCP server for Substack. 65 tools for drafts, posts, Notes, subscribers, analytics, tags, comments, the reader feed, and research. Works with Claude Code, Claude Desktop, Cursor, Windsurf, and any MCP-compatible client.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "substack-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Navid Moazzez <https://navid.me>",
  "homepage": "https://navid.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/substack-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/thenavidm/substack-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "substack",
    "newsletter",
    "mcp-server",
    "claude",
    "claude-code",
    "ai-agents",
    "llm-tools"
  ],
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ]
}
